# Sakhi server — environment
# Copy to .env (or export these) and fill in what you need. Everything here is
# optional: with no keys at all the app still runs, using rules-only triage and
# on-device OCR. That is a real degraded mode, not a broken one.

# ---------------------------------------------------------------------------
# Prescription OCR
# ---------------------------------------------------------------------------
# Which provider reads prescription photographs.
#   gemini  (default) — Gemini Vision. Reads handwriting, returns structured
#                       medicine/strength/frequency rather than a flat string.
#   gcv               — Google Cloud Vision DOCUMENT_TEXT_DETECTION. Excellent
#                       on printed prescriptions, weaker on cursive.
# With no key set, the client falls back to Tesseract in the browser. That keeps
# the image on the phone but reads handwriting badly.
OCR_PROVIDER=gemini

# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional — defaults to gemini-2.5-flash. Flash is the right default here:
# prescription reading is a short constrained extraction, and Pro's extra
# capability does not pay for its latency on a rural connection.
# GEMINI_MODEL=gemini-2.5-flash

# Only needed if OCR_PROVIDER=gcv. Enable the Cloud Vision API on the project
# first: https://console.cloud.google.com/apis/library/vision.googleapis.com
GOOGLE_VISION_API_KEY=

# A single key usable for both, if you prefer. Provider-specific keys win.
# GOOGLE_API_KEY=

# How long to wait for the vision provider before falling back to on-device.
# OCR_TIMEOUT_MS=25000

# PRIVACY NOTE
# Setting a key changes what the app does with a photograph: the image is
# relayed through this server to Google rather than staying on the phone. The
# prescription screen tells the user this before they choose a file, and offers
# a switch to force on-device reading. If you change providers, check that the
# disclosure text still matches your provider's retention terms.

# ---------------------------------------------------------------------------
# Triage reasoning (IBM watsonx.ai Granite)
# ---------------------------------------------------------------------------
# Without these the rules engine runs alone. The model can only ever RAISE the
# urgency the rules produced, never lower it.
WATSONX_API_KEY=
WATSONX_PROJECT_ID=
# WATSONX_URL=https://us-south.ml.cloud.ibm.com

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
# PORT=4000
# ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Set only when running behind a reverse proxy you control, so that
# X-Forwarded-For can be trusted for rate limiting.
# TRUST_PROXY=false

# ---------------------------------------------------------------------------
# Demo accounts (development only)
# ---------------------------------------------------------------------------
# Password used by `npm run seed:demo`.
# DEMO_PASSWORD=SakhiDemo@2026!
